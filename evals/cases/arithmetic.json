{
  "description": "Fixed arithmetic case set for evals/leaderboard.py and evals/ablation.py. Integer and terminating-decimal expressions only; 'expected' is the exact answer, compared as a rational number.",
  "version": 1,
  "cases": [
    {"id": "add-small", "expression": "2+2", "expected": "4"},
    {"id": "mul-7x8", "expression": "7*8", "expected": "56"},
