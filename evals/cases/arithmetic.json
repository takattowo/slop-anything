    {"id": "mul-4x14", "expression": "4*14", "expected": "56"},
    {"id": "mul-6x9", "expression": "6*9", "expected": "54"},
    {"id": "dec-add", "expression": "0.1+0.2", "expected": "0.3"},
    {"id": "dec-sub", "expression": "1-0.9", "expected": "0.1"},
    {"id": "dec-mul", "expression": "0.5*0.5", "expected": "0.25"},
    {"id": "dec-sum-int", "expression": "3.75+1.25", "expected": "5"},
    {"id": "dec-times-int", "expression": "2.5*4", "expected": "10"},
    {"id": "precedence-chain", "expression": "9-3/3*2", "expected": "7"},
