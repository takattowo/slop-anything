    {"id": "square-13", "expression": "13*13", "expected": "169"},
    {"id": "div-half", "expression": "7/2", "expected": "3.5"},
    {"id": "div-quarter", "expression": "10/4", "expected": "2.5"},
    {"id": "div-exact", "expression": "45/9", "expected": "5"},
    {"id": "floordiv", "expression": "17//5", "expected": "3"},
    {"id": "mod", "expression": "17%5", "expected": "2"},
    {"id": "unary-minus", "expression": "-5+2", "expected": "-3"},
    {"id": "carry", "expression": "99+1", "expected": "100"}
